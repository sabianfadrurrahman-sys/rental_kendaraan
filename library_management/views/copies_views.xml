<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_book_copies_list" model="ir.ui.view">
        <field name="name">book.copies.list</field>
        <field name="model">book.copies</field>
        <field name="arch" type="xml">
            <list string="Daftar Eksemplar">
                <field name="name"/>
                <field name="code"/>
                <!-- Status menggunakan widget badge agar lebih cantik di list view -->
                <field name="status" widget="badge" decoration-success="status == 'ready'" decoration-warning="status == 'borrowed'" decoration-danger="status == 'lost'"/>
                <field name="book_id"/>
                <field name="membership_id"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_book_copies_form" model="ir.ui.view">
        <field name="name">book.copies.form</field>
        <field name="model">book.copies</field>
        <field name="arch" type="xml">
            <form string="Detail Eksemplar">
                <header>
                    <!-- HAPUS clickable: '1' agar status hanya bisa diubah otomatis oleh sistem -->
                    <field name="status" widget="statusbar" statusbar_visible="ready,borrowed,lost"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="book_id"/>
                        </group>
                        <group>
                            <!-- Hanya tampilkan nama peminjam jika statusnya 'borrowed' -->
                            <field name="membership_id" invisible="status != 'borrowed'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>