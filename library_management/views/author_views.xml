<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. LIST VIEW (Pengganti list View) -->
        <record id="view_library_author_list" model="ir.ui.view">
            <field name="name">library.author.list</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <list string="Daftar Penulis">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- 2. FORM VIEW -->
        <record id="view_library_author_form" model="ir.ui.view">
            <field name="name">library.author.form</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <form string="Profil Penulis">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ketik nama penulis..."/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Daftar Buku Karangan">
                                <field name="book_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- 3. ACTION -->
    </data>
</odoo>