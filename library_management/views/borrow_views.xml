<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  SERVER ACTION  -->
    <record id="server_action_update_late_books" model="ir.actions.server">
        <field name="name">Update Late Books</field>
        <field name="model_id" ref="model_library_borrow"/>
        <field name="binding_model_id" ref="model_library_borrow"/>
        <field name="state">code</field>
        <!-- Kode dipanggil dalam 1 baris agar bebas dari error indentasi -->
        <field name="code">model.action_update_late_books()</field>
    </record>

    <!--  FORM VIEW  -->
    <record id="view_library_borrow_form" model="ir.ui.view">
        <field name="name">library.borrow.form</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <form string="Transaksi Peminjaman">
                <header>
                    <!-- Tombol Workflow Modern Odoo 18 -->
                    <button name="action_request_approval" string="Minta Persetujuan" type="object" class="oe_highlight" invisible="state != 'draft'"/>

                    <!-- Tombol Approve (Misal dibatasi hanya untuk admin sistem) -->
                    <!-- Tombol Approve hanya bisa diklik oleh Library Manager -->
                    <button name="action_approve" string="Setujui Pinjaman" type="object" class="oe_highlight" invisible="state != 'to_approve'" groups="library_management.group_library_manager"/>
                    <button name="%(server_action_update_late_books)d" string="Cek Keterlambatan" type="action" class="btn-danger"/>
                    <button name="%(library_management.action_library_reject_wizard)d" string="Tolak Peminjaman" type="action" class="btn-danger" invisible="state != 'to_approve'"/>
                    <button name="%(library_management.action_library_extend_wizard)d" string="Perpanjang Peminjaman" type="action" class="btn-secondary" invisible="state != 'ongoing'"/>
                    <!-- Status bar mengikuti urutan workflow -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,ongoing,returned,late"/>
                </header>
                <sheet>
                    <group>
                        <group string="Data Pinjaman">
                            <field name="name"/>
                            <field name="membership_id"/>
                            <field name="book_id"/>
                            <field name="copies_id"/>
                        </group>
                        <group string="Waktu &amp; Biaya">
                            <field name="datetime_from"/>
                            <field name="datetime_to"/>
                            <field name="duration" readonly="1"/>
                            <field name="fine"/>
                        </group>
                    </group>
                </sheet>
                <!-- TAMBAHKAN CHATTER DI SINI (Paling bawah sebelum penutup form) -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- LIST VIEW  -->
    <record id="view_library_borrow_list" model="ir.ui.view">
        <field name="name">library.borrow.list</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <list string="Peminjaman">
                <field name="membership_id"/>
                <field name="copies_id"/>
                <field name="book_id"/>
                <field name="datetime_from"/>
                <field name="datetime_to"/>
                <field name="fine"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!--  CALENDAR VIEW -->
    <record id="view_library_borrow_calendar" model="ir.ui.view">
        <field name="name">library.borrow.calendar</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <calendar string="Kalender Peminjaman" date_start="datetime_from" date_stop="datetime_to" color="membership_id">
                <field name="membership_id"/>
                <field name="book_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- PIVOT VIEW  -->
    <record id="view_library_borrow_pivot" model="ir.ui.view">
        <field name="name">library.borrow.pivot</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Peminjaman">
                <field name="membership_id" type="row"/>
                <field name="membership_id" type="row"/>
                <field name="book_id" type="col"/>
                <field name="fine" type="measure"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW  -->
    <record id="view_library_borrow_graph" model="ir.ui.view">
        <field name="name">library.borrow.graph</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <graph string="Statistik Peminjaman" type="bar">
                <field name="membership_id" type="row"/>
                <field name="membership_id" type="row"/>
                <field name="fine" type="measure"/>
            </graph>
        </field>
    </record>

    <!--  ACTION  -->


</odoo>