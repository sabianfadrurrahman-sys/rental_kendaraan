<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_download_excel_borrow" model="ir.actions.server">
        <field name="name">Cetak Bukti Peminjaman (Excel)</field>
        <field name="model_id" ref="library_management.model_library_borrow"/>
        <field name="binding_model_id" ref="library_management.model_library_borrow"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
ids_str = ','.join(str(i) for i in records.ids)
action = {
    'type': 'ir.actions.act_url',
    'url': '/library/download_excel?borrow_ids=' + ids_str,
    'target': 'new',
}
        </field>
    </record>
</odoo>