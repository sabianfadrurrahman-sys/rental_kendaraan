<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Cari Buku">
                <field name="name"/>
                <field name="author_id"/>
                <field name="category_ids"/>
                
                <filter name="available" string="Tersedia" domain="[('state','=','available')]"/>
                <filter name="borrowed" string="Dipinjam" domain="[('state','=','borrowed')]"/>
                
                <group expand="1" string="Group By">
                    <filter name="group_author" string="Penulis" context="{'group_by':'author_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                </group>

                <searchpanel>
                    <field name="state" icon="fa-list" select="multi" enable_counters="1"/>
                    <field name="author_id" icon="fa-users" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_example">
                <field name="name"/>
                <field name="author_id"/>
                <field name="category_ids"/>
                <field name="published_year"/>
                <field name="state"/>
                <field name="available_copies_count"/>
                
                <templates>
                    <!-- Ubah namanya menjadi card -->
                    <t t-name="card">
                        <div class="o_kanban_card oe_kanban_global_click">
                            <strong class="o_kanban_record_title" style="font-size: 16px;"><field name="name"/></strong>
                            <!-- Menggunakan ikon FontAwesome agar layout lebih clean -->
                            <div class="mt-1"><i class="fa fa-user me-2"/> <field name="author_id"/></div>
                            <div><i class="fa fa-calendar me-2"/> <field name="published_year"/></div>
                            <div class="mt-2"><field name="category_ids" widget="many2many_tags"/></div>
                            
                            <div class="mt-2">
                                <span class="badge text-bg-success">
                                    Tersedia: <field name="available_copies_count"/> Eksemplar
                                </span>
                            </div>

                            <div class="mt-2">
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'available'" decoration-warning="state == 'borrowed'" decoration-danger="state == 'lost'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author_id"/> 
                <field name="published_year"/>
                <field name="pages"/> 
                <field name="reading_time" widget="float_time"/> 
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'available'" decoration-warning="state == 'borrowed'" decoration-danger="state == 'lost'"/> 
            </list>
        </field>
    </record>

    <!-- FORM VIEW  -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_check_books" string="Cek Buku Tebal" type="object" class="btn-secondary"/>
                    
                    <!-- Gunakan ID action dari borrow_views.xml -->
                    <button name="%(library_management.action_library_borrow)d" 
                        type="action" 
                        string="Pinjam Buku Ini" 
                        class="oe_highlight"
                        context="{'default_book_id': id}"
                        groups="library_management.group_library_user"
                        invisible="state != 'available'"/>

                    <!-- Hapus clickable="1" dan sesuaikan statusbar_visible -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,archived"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informasi Utama">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="author_id"/> 
                            <field name="publisher_id"/>
                            <field name="category_ids" widget="many2many_tags"/> 
                        </group>
                        <group string="Detail Buku">
                            <field name="published_year"/>
                            <field name="pages"/>
                            <field name="reading_time" readonly="1"/> 
                            <field name="remark" readonly="1"/> 
                            <field name="active"/>
                            <field name="jumlah_pinjam"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Eksemplar (Copies)">
                            <field name="book_copies_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code" optional="show"/>
                                    <field name="status" widget="badge" decoration-success="status == 'ready'" decoration-warning="status == 'borrowed'"/>
                                    <field name="membership_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="History Peminjaman Buku">
                            <field name="history_borrow_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="datetime_from"/>
                                    <field name="datetime_to"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook> 
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS & MENU -->
</odoo>