<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_reject_wizard_form" model="ir.ui.view">
        <field name="name">library.reject.wizard.form</field>
        <field name="model">library.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfirmasi Penolakan">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Tolak Peminjaman" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action untuk memanggil wizard -->
    <record id="action_library_reject_wizard" model="ir.actions.act_window">
        <field name="name">Alasan Penolakan</field>
        <field name="res_model">library.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- KUNCI UTAMA: target="new" membuat form terbuka sebagai pop-up dialog -->
    </record>
</odoo>