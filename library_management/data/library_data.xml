<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate ="1">
    <!-- 1. Data Penulis (Author) -->
    <record id="author_john_doe" model="library.author">
        <field name="name">John Doe</field>
    </record>
    <record id="author_jane_smith" model="library.author">
        <field name="name">Jane Smith</field>
    </record>
    <record id="author_nevzat_tarhan" model="library.author">
        <field name="name">Nevzat Tarhan</field>
    </record>
    <record id="author_morgan_housel" model="library.author">
        <field name="name">Morgan Housel</field>
    </record>

    <!-- 2. Data Kategori (Category) -->
    <record id="category_programming" model="library.category">
        <field name="name">Programming</field>
    </record>
    <record id="category_fiction" model="library.category">
        <field name="name">Fiction</field>
    </record>
    <record id="category_finance" model="library.category">
        <field name="name">Finance</field>
    </record>
    <record id="category_self_improvement" model="library.category">
        <field name="name">Self Improvement</field>
    </record>

    <!-- 3. Data Penerbit (Publisher) -->
    <record id="publisher_gramedia" model="library.publisher">
        <field name="name">PT Gramedia Pustaka Utama</field>
        <field name="publisher_code">PUB-GRAMEDIA</field>
        <field name="rating">gold</field>
    </record>

    <!-- 4. Data Buku (Book) -->
    <record id="book_python101" model="library.book">
        <field name="name">Python 101 (Edisi terbaru) </field>
        <field name="author_id" ref="author_john_doe"/>
        <field name="publisher_id" ref="publisher_gramedia"/>
        <field name="published_year">2024</field>
        <field name="pages">250</field>
        <field name="category_ids" eval="[(6, 0, [ref('category_programming')])]"/>
        <field name="state">available</field>
        <field name="code">BOOK/2026/0001</field> 
    </record>

    <record id="book_odoo_essentials" model="library.book">
        <field name="name">Odoo Essentials (Edisi Spesial)</field>
        <field name="author_id" ref="author_jane_smith"/>
        <field name="publisher_id" ref="publisher_gramedia"/>
        <field name="published_year">2005</field>
        <field name="pages">320</field>
        <field name="category_ids" eval="[(6, 0, [ref('category_programming')])]"/>
        <field name="state">available</field>
        <field name="code">BOOK/2026/0002</field>
    </record>

    <record id="book_psychology_of_money" model="library.book">
        <field name="name">Psychology of Money (Edisi Baru)</field>
        <field name="author_id" ref="author_morgan_housel"/>
        <field name="publisher_id" ref="publisher_gramedia"/>
        <field name="published_year">2019</field> <!-- Pastikan tahunnya memang 2005 -->
        <field name="pages">320</field>
        <field name="category_ids" eval="[(6, 0, [ref('category_finance'), ref('category_self_improvement')])]"/>
        <field name="state">available</field>
        <field name="code">BOOK/2026/0003</field>
    </record>

    <record id="book_psychology_of_women" model="library.book">
        <field name="name">Psychology of Women (Edisi terbaru) </field>
        <field name="author_id" ref="author_nevzat_tarhan"/>
        <field name="publisher_id" ref="publisher_gramedia"/>
        <field name="published_year">2024</field> <!-- Pastikan tahunnya memang 2005 -->
        <field name="pages">320</field>
        <field name="category_ids" eval="[(6, 0, [ref('category_self_improvement')])]"/>
        <field name="state">available</field>
        <field name="code">BOOK/2026/0004</field>
    </record>
    </data>
</odoo>