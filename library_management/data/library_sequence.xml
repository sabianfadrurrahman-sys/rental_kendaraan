<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 1. Sequence untuk Katalog Buku -->
    <record id="seq_library_book" model="ir.sequence">
        <field name="name">Library Book Sequence</field>
        <field name="code">library.book</field>
        <field name="prefix">BOOK/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>

    <!-- 2. Sequence untuk Transaksi Peminjaman -->
    <record id="seq_library_borrow" model="ir.sequence">
        <field name="name">Library Peminjaman Sequence</field>
        <field name="code">library.borrow</field>
        <field name="prefix">BRW/%(year)s/</field> <!-- Prefix diperbaiki -->
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>

    <!-- 3. BARU: Sequence untuk Fisik Buku (Eksemplar) -->
    <record id="seq_library_copies" model="ir.sequence">
        <field name="name">Library Copies</field>
        <field name="code">book.copies</field>
        <field name="prefix">CPY/</field> <!-- Tidak perlu tahun, cukup CPY/0001 dst -->
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>

    <record id="seq_library_member" model="ir.sequence">
        <field name="name">Library member</field>
        <field name="code">library.member</field>
        <field name="prefix">Agt/</field> <!-- Tidak perlu tahun, cukup CPY/0001 dst -->
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>

</odoo>