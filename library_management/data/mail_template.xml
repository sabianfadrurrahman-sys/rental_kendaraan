<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_borrow_overdue" model="mail.template">
        <field name="name">Reminder Keterlambatan Buku</field>
        <field name="model_id" ref="model_library_borrow"/>
        <field name="subject">Peringatan: Buku yang Anda Pinjam Terlambat</field>
        <field name="email_from">{{object.env.company.email or 'admin@perpustakaan.com'}}</field>
        <field name="email_to">{{object.membership_id.email}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Halo <strong><t t-out="object.membership_id.name"/></strong>,</p>
                <p>Kami dari Perpustakaan Digital ingin mengingatkan bahwa buku yang Anda pinjam:</p>
                <ul>
                    <li><strong>Judul Buku:</strong> <t t-out="object.book_id.name"/></li>
                    <li><strong>Batas Pengembalian:</strong> <t t-out="format_date(object.datetime_to)"/></li>
                </ul>
                <p>Saat ini telah melewati batas waktu pengembalian. Mohon segera mengembalikan buku tersebut untuk menghindari penambahan denda.</p>
                <p>Terima kasih,<br/>Tim Perpustakaan</p>
            </div>
        </field>
    </record>
</odoo>