<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" bagus untuk file security agar rule tidak kerestart saat modul di-upgrade -->
    <data noupdate="1"> 
        
        <record model="ir.module.category" id="module_category_library">
            <field name="name">Library Management</field>
            <field name="description">Library Management</field>
        </record>
        
        <!-- Tingkat 1: User -->
        <record id="group_library_user" model="res.groups">
            <field name="name">Library User</field>
            <field name="category_id" ref="module_category_library"/>
        </record>
        
        <!-- Tingkat 2: Officer (Baru) -->
        <record id="group_library_officer" model="res.groups">
            <field name="name">Library Officer</field>
            <field name="category_id" ref="module_category_library"/>
            <!-- Mewarisi akses dari User -->
            <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
        </record>
    
        <!-- Tingkat 3: Manager (Di-update) -->
        <record id="group_library_manager" model="res.groups">
            <field name="name">Library Manager</field>
            <field name="category_id" ref="module_category_library"/>
            <!-- Mewarisi akses dari Officer -->
            <field name="implied_ids" eval="[(4, ref('group_library_officer'))]"/>
        </record>

        <!-- Tingkat 4: Administrator (Baru) -->
        <record id="group_library_administrator" model="res.groups">
            <field name="name">Library Administrator</field>
            <field name="category_id" ref="module_category_library"/>
            <!-- Mewarisi akses dari Manager -->
            <field name="implied_ids" eval="[(4, ref('group_library_manager'))]"/>
        </record>
        
        <!-- 2. GRUP DATA TAMBAHAN                      -->
        <record id="group_library_user_data" model="res.groups">
            <field name="name">User Data</field>
            <field name="category_id" ref="module_category_library"/>
        </record>
        
        <record id="group_library_admin_data" model="res.groups">
            <field name="name">Admin Data</field>
            <field name="category_id" ref="module_category_library"/>
        </record>

        <!-- 3. RECORD RULE (Poin 3 di Gambar)-->
        <record id="rule_user_data_author" model="ir.rule">
            <field name="name">User Data hanya melihat datanya sendiri</field>
            <!-- ref ini harus sinkron dengan nama _name di model Python (titik diganti underscore) -->
            <field name="model_id" ref="model_library_author"/>
            <!-- Ditempelkan ke grup User Data -->
            <field name="groups" eval="[(4, ref('group_library_user_data'))]"/>
            <!-- Logika domain filternya -->
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

    </data>
</odoo>