<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View Rental Vehicle -->
    <record id="rental_vehicle_view_form" model="ir.ui.view">
        <field name="name">rental.vehicle.view.form</field>
        <field name="model">rental.vehicle</field>
        <field name="arch" type="xml">
            <form string="Rental Vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="brand"/>
                        </group>
                        <group>
                            <field name="model_year"/>
                            <field name="seat_count"/>
                            <field name="daily_rate"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View Rental Vehicle -->
    <record id="rental_vehicle_view_list" model="ir.ui.view">
        <field name="name">rental.vehicle.view.list</field>
        <field name="model">rental.vehicle</field>
        <field name="arch" type="xml">
            <list string="Rental Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="daily_rate"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Action Rental Vehicle -->
    <record id="rental_vehicle_action" model="ir.actions.act_window">
        <field name="name">Rental Vehicle</field>
        <field name="res_model">rental.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Root Menu -->
    <menuitem
        id="rental_vehicle_root_menu"
        name="Rental Kendaraan"
        sequence="10"/>

    <!-- Sub Menu -->
    <menuitem
        id="rental_vehicle_menu"
        name="Rental Vehicle"
        parent="rental_vehicle_root_menu"
        action="rental_vehicle_action"
        sequence="10"/>

</odoo>