<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW VEHICLE -->
    <record id="rental_vehicle_view_form" model="ir.ui.view">
        <field name="name">rental.vehicle.view.form</field>
        <field name="model">rental.vehicle</field>
        <field name="arch" type="xml">
            <form string="Rental Vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="brand"/>
                        </group>
                        <group>
                            <field name="model_year"/>
                            <field name="seat_count"/>
                            <field name="daily_rate"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW VEHICLE -->
    <record id="rental_vehicle_view_list" model="ir.ui.view">
        <field name="name">rental.vehicle.view.list</field>
        <field name="model">rental.vehicle</field>
        <field name="arch" type="xml">
            <list string="Rental Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="daily_rate"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ACTION VEHICLE -->
    <record id="rental_vehicle_action" model="ir.actions.act_window">
        <field name="name">Rental Vehicle</field>
        <field name="res_model">rental.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ACTION ORDER -->
    <record id="rental_order_action" model="ir.actions.act_window">
        <field name="name">Rental Order</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ROOT MENU -->
    <menuitem id="rental_vehicle_root_menu" name="Rental Kendaraan" sequence="10"/>

    <!-- SUB MENUS -->
    <menuitem id="rental_vehicle_menu" name="Vehicle" parent="rental_vehicle_root_menu" action="rental_vehicle_action" sequence="10"/>
    <menuitem id="rental_order_menu" name="Rental Orders" parent="rental_vehicle_root_menu" action="rental_order_action" sequence="20"/>

</odoo>